#!/data/data/com.termux/files/usr/bin/bash
# Termux Style uninstaller
#
# Usage:
#   ./uninstall          Confirm before uninstalling
#   ./uninstall --yes    Uninstall without prompting
#   ./uninstall --help

set -o pipefail

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
CYAN=$'\033[36m'
RESET=$'\033[0m'

say()  { printf '%b\n' "$*"; }
info() { say "  ${BLUE}*${RESET} $*"; }
ok()   { say "  ${GREEN}✓${RESET} $*"; }
warn() { say "  ${YELLOW}!${RESET} $*" >&2; }

cleanup() {
    tput sgr0 2>/dev/null || true
    tput op 2>/dev/null || true
    printf '%b' "$RESET"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<'EOF'
Usage: ./uninstall [--yes | --help]

Removes the Termux Style command at $PREFIX/bin/style.
It does not remove color schemes, fonts, configuration, or backups.
EOF
}

main() {
    local assume_yes=false
    local target answer

    case "${1:-}" in
        --yes|-y)
            assume_yes=true
            ;;
        --help|-h)
            usage
            return 0
            ;;
        "")
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac

    if [[ -z "${PREFIX:-}" || ! -d "$PREFIX/bin" ]]; then
        warn "Termux's bin directory was not found. Run this script inside Termux."
        return 1
    fi

    target="$PREFIX/bin/style"

    say "${BLUE}Termux Style Uninstaller${RESET}"
    printf '\n'

    if [[ ! -e "$target" && ! -L "$target" ]]; then
        info "No style command was found at $target"
        return 0
    fi

    info "This will remove: $target"
    say "Your color schemes, fonts, Termux settings, and installer backups will be kept."
    printf '\n'

    if [[ "$assume_yes" != true ]]; then
        printf 'Uninstall the style command? [y/N] '
        IFS= read -r answer || answer=""
        case "${answer,,}" in
            y|yes) ;;
            *)
                info "Uninstall cancelled."
                return 0
                ;;
        esac
    fi

    if ! rm -- "$target"; then
        warn "Could not remove $target"
        return 1
    fi

    if [[ -e "$target" || -L "$target" ]]; then
        warn "The style command still exists; uninstall may not have completed."
        return 1
    fi

    ok "Uninstalled the style command."
    info "Your schemes, fonts, settings, and backups were left intact."
}

main "$@"

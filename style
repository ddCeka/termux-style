#!/data/data/com.termux/files/usr/bin/bash

# A simple script to change color-schemes & fonts of termux terminal emulator.

set -u
set -o pipefail

# -----------------------------------------------------------------------------
# ANSI Colors
# -----------------------------------------------------------------------------
RED=$'\033[31m'
GREEN=$'\033[32m'
ORANGE=$'\033[33m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
CYAN=$'\033[36m'
WHITE=$'\033[37m'
BLACK=$'\033[30m'
REDBG=$'\033[41m'
GREENBG=$'\033[42m'
ORANGEBG=$'\033[43m'
BLUEBG=$'\033[44m'
MAGENTABG=$'\033[45m'
CYANBG=$'\033[46m'
WHITEBG=$'\033[47m'
BLACKBG=$'\033[40m'
DEFAULT_FG=$'\033[39m'
DEFAULT_BG=$'\033[49m'

# -----------------------------------------------------------------------------
# Directories
# -----------------------------------------------------------------------------
TERMUX_DIR="$HOME/.termux"
COLORS_DIR="$TERMUX_DIR/colors"
DIRCOLORS_DIR="$TERMUX_DIR/dircolors"
FONTS_DIR="$TERMUX_DIR/fonts"
PREFIX_DIR="${PREFIX:-/data/data/com.termux/files/usr}"
CACHE_DIR="$TERMUX_DIR/cache"
FONT_RELEASES_DIR="$CACHE_DIR/releases"

readonly NERDFONTSAPI='https://api.github.com/repos/ryanoasis/nerd-fonts'
readonly NERDFONTSREPO='https://github.com/ryanoasis/nerd-fonts'
readonly RELEASE_FILE="$CACHE_DIR/release.txt"
readonly ALL_FONTS_FILE="$CACHE_DIR/all_fonts.txt"

NEW_RELEASE_AVAILABLE=false
KEEP_FONT_ARCHIVES=false
INCLUDE_INSTALLED_FONTS=false
UPDATE_INSTALLED_FONTS=false
DISPLAY_INSTALLED_FONTS=false
DISPLAY_ALL_FONTS=false

# -----------------------------------------------------------------------------
# Utility functions
# -----------------------------------------------------------------------------
banner() {
    clear 2>/dev/null || true
    echo "
    ${BLUE}┌──────────────────────────────────────────────────┐
    ${BLUE}│${RED}░▀█▀░█▀▀░█▀▄░█▄█░█░█░█░█${ORANGE}░░░░░${GREEN}█▀▀░▀█▀░█░█░█░░░█▀▀░░${BLUE}│
    ${BLUE}│${RED}░░█░░█▀▀░█▀▄░█░█░█░█░▄▀▄${ORANGE}░▄▄▄${RED}░${GREEN}▀▀█░░█░░░█░░█░░░█▀▀░░${BLUE}│
    ${BLUE}│${RED}░░▀░░▀▀▀░▀░▀░▀░▀░▀▀▀░▀░▀${ORANGE}░░░░░${GREEN}▀▀▀░░▀░░░▀░░▀▀▀░▀▀▀░░${BLUE}│
    ${BLUE}└──────────────────────────────────────────────────┘
    ${BLUE}"
}

reset_color() {
    tput sgr0 2>/dev/null || true
    tput op 2>/dev/null || true
    return
}

ensure_dirs() {
    mkdir -p -- "$TERMUX_DIR" "$COLORS_DIR" "$DIRCOLORS_DIR" "$FONTS_DIR" "$CACHE_DIR" "$FONT_RELEASES_DIR"
}

list_files() {
    local dir="$1"
    local path
    FILES=()

    shopt -s nullglob
    for path in "$dir"/*; do
        if [[ -f "$path" ]]; then
            FILES+=("$path")
        fi
    done
    shopt -u nullglob
}

check_files() {
    local kind="$1"
    local dir=""
    case "$kind" in
        colors) dir="$COLORS_DIR" ;;
        dircolor) dir="$DIRCOLORS_DIR" ;;
        fonts) dir="$FONTS_DIR" ;;
        *) echo 0; return 0 ;;
    esac

    list_files "$dir"
    echo "${#FILES[@]}"
}

# -----------------------------------------------------------------------------
# Reload functions
# -----------------------------------------------------------------------------
reload_settings() {
    case "${TERMUX__USER_ID:-}" in
        ''|*[!0-9]*|0[0-9]*)
            TERMUX__USER_ID=0
            ;;
    esac

    echo "    ${BLUE}[${RED}*${BLUE}] ${MAGENTA}Reloading Settings..."
    am broadcast --user "$TERMUX__USER_ID" -a "com.termux.app.reload_style" "com.termux" >/dev/null 2>&1 || true
    echo "    ${BLUE}[${RED}*${BLUE}] ${GREEN}Applied Successfully."
    echo
}

reload_dircolor() {
    echo "    ${BLUE}[${RED}*${BLUE}] ${MAGENTA}Reloading Dircolors..."
    eval "$(dircolors -b "$HOME/.dircolors" 2>/dev/null)"
    echo "    ${BLUE}[${RED}*${BLUE}] ${GREEN}Applied Successfully."
    echo
}

# -----------------------------------------------------------------------------
# Theme selection helpers
# -----------------------------------------------------------------------------
select_file_from_dir() {
    local title="$1"
    local dir="$2"
    local target="$3"
    local -a choices=()
    local answer
    local i

    list_files "$dir"
    choices=("${FILES[@]}")

    if (( ${#choices[@]} == 0 )); then
        echo
        echo "    ${BLUE}[${RED}!${BLUE}] ${RED}No files found in $dir"
        echo
        return 1
    fi

    echo "$title"
    for i in "${!choices[@]}"; do
        printf '    %b[%d] %s\n' "$ORANGE" "$((i + 1))" "${choices[$i]##*/}"
    done

    echo
    read -r -p "    ${BLUE}[${RED}Select Option${BLUE}]: ${GREEN}" answer
    echo

    if [[ ! "$answer" =~ ^[0-9]+$ ]] || (( answer < 1 || answer > ${#choices[@]} )); then
        echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Back to menu."
        echo
        return 1
    fi

    local selected="${choices[$((answer - 1))]}"
    ln -sfn -- "$selected" "$target"
    return 0
}

# -----------------------------------------------------------------------------
# Apply color schemes
# -----------------------------------------------------------------------------
apply_colors() {
    local count=1
    local file
    local name

    list_files "$COLORS_DIR"
    if (( ${#FILES[@]} == 0 )); then
        echo "    ${BLUE}[${RED}!${BLUE}] ${RED}No color schemes found."
        return
    fi

    for file in "${FILES[@]}"; do
        name="${file##*/}"
        name="${name%.*}"
        echo "${ORANGE}    [$count] $name"
        count=$((count + 1))
    done

    echo
    read -r -p "    ${BLUE}[${RED}Select Color Scheme (1 to ${#FILES[@]})${BLUE}]: ${GREEN}" answer
    echo

    if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#FILES[@]} )); then
        local scheme_path="${FILES[$((answer - 1))]}"
        echo "    ${BLUE}[${RED}*${BLUE}] ${ORANGE}Applying Color Scheme..."
        ln -sfn -- "$scheme_path" "$TERMUX_DIR/colors.properties"
        reload_settings
        reset_color
    else
        echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Back to menu."
        echo
    fi
}

# -----------------------------------------------------------------------------
# Apply dircolor schemes
# -----------------------------------------------------------------------------
apply_dircolor() {
    local count=1
    local file
    local name

    list_files "$DIRCOLORS_DIR"
    if (( ${#FILES[@]} == 0 )); then
        echo "    ${BLUE}[${RED}!${BLUE}] ${RED}No dircolor schemes found."
        return
    fi

    for file in "${FILES[@]}"; do
        name="${file##*/}"
        name="${name%.*}"
        echo "${ORANGE}    [$count] $name"
        count=$((count + 1))
    done

    echo
    read -r -p "    ${BLUE}[${RED}Select Dircolor Scheme (1 to ${#FILES[@]})${BLUE}]: ${GREEN}" answer
    echo

    if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#FILES[@]} )); then
        local scheme_path="${FILES[$((answer - 1))]}"
        echo "    ${BLUE}[${RED}*${BLUE}] ${ORANGE}Applying Dircolor Scheme..."
        ln -sfn -- "$scheme_path" "$HOME/.dircolors"
        reload_dircolor
        reset_color
    else
        echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Back to menu."
        echo
    fi
}

# -----------------------------------------------------------------------------
# Apply fonts
# -----------------------------------------------------------------------------
apply_fonts() {
    local count=1
    local file
    local name

    list_files "$FONTS_DIR"
    if (( ${#FILES[@]} == 0 )); then
        echo "    ${BLUE}[${RED}!${BLUE}] ${RED}No fonts found."
        return
    fi

    for file in "${FILES[@]}"; do
        name="${file##*/}"
        name="${name%.*}"
        echo "${ORANGE}    [$count] $name"
        count=$((count + 1))
    done

    echo
    read -r -p "    ${BLUE}[${RED}Select font (1 to ${#FILES[@]})${BLUE}]: ${GREEN}" answer
    echo

    if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#FILES[@]} )); then
        local font_path="${FILES[$((answer - 1))]}"
        echo "    ${BLUE}[${RED}*${BLUE}] ${ORANGE}Applying Font..."
        ln -sfn -- "$font_path" "$TERMUX_DIR/font.ttf"
        reload_settings
        reset_color
    else
        echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Back to menu."
        echo
        reset_color
    fi
}

# -----------------------------------------------------------------------------
# Random style
# -----------------------------------------------------------------------------
random_style() {
    local -a schemes=()
    local random_scheme

    list_files "$COLORS_DIR"
    schemes=("${FILES[@]}")

    if (( ${#schemes[@]} == 0 )); then
        echo "    ${BLUE}[${RED}!${BLUE}] ${RED}No color schemes found."
        return
    fi

    random_scheme="${schemes[$((RANDOM % ${#schemes[@]}))]}"
    echo "    ${BLUE}[${RED}*${BLUE}] ${ORANGE}Setting Random Style..."
    ln -sfn -- "$random_scheme" "$TERMUX_DIR/colors.properties"
    reload_settings
    reset_color
}

# -----------------------------------------------------------------------------
# Nerd Fonts downloader
# -----------------------------------------------------------------------------
download_fonts() {
    info() { printf '%b\n' "$1"; }
    title() { printf '%b\n' "$1"; }
    confirm() { printf '%b\n' "$1"; }
    alert() { printf '%b\n' "$1" >&2; }
    error_msg() { printf '%b\n' "$1" >&2; return 1; }

    create_dirs() {
        mkdir -p -- "$TERMUX_DIR" "$COLORS_DIR" "$DIRCOLORS_DIR" "$FONTS_DIR" "$CACHE_DIR" "$FONT_RELEASES_DIR"
    }

    verify_internet_access() {
        if ! curl --silent --head --fail "$NERDFONTSAPI" >/dev/null 2>&1; then
            alert "Couldn't connect to the Nerd Fonts API."
            error_msg "Most likely the internet connection is not working."
            return 1
        fi
    }

    check_dependencies() {
        command -v curl >/dev/null 2>&1 || { error_msg "curl is required."; return 1; }
        command -v tar >/dev/null 2>&1 || { error_msg "tar is required."; return 1; }
        create_dirs
        verify_internet_access || return 1
    }

    get_latest_release_version() {
        local tag
        tag=$(curl --silent --fail --location "$NERDFONTSAPI/releases/latest" 2>/dev/null |
            awk -v RS=',' -F'"' '/tag_name/ {print $4}' | head -n 1)

        if [[ -z "$tag" ]]; then
            error_msg "Could not determine the latest Nerd Fonts release."
            return 1
        fi

        if [[ -f "$RELEASE_FILE" ]]; then
            local current_release
            current_release=$(cat "$RELEASE_FILE" 2>/dev/null || true)
            if [[ -n "$current_release" && "$current_release" != "$tag" ]]; then
                NEW_RELEASE_AVAILABLE=true
            fi
        fi

        printf '%s\n' "$tag" > "$RELEASE_FILE"
        printf '%s\n' "$tag"
    }

    get_font_release_file() {
        printf '%s\n' "$FONT_RELEASES_DIR/${1}_release.txt"
    }

    is_latest_version() {
        local font_name="$1"
        local font_release_file
        font_release_file="$(get_font_release_file "$font_name")"

        if [[ -f "$font_release_file" ]]; then
            local version
            version=$(cat "$font_release_file" 2>/dev/null || true)
            if [[ "$version" == "$RELEASE" ]]; then
                return 0
            fi
        fi
        return 1
    }

    create_all_fonts_file() {
        local font_list
        font_list=$(curl --silent --fail --location "$NERDFONTSAPI/contents/patched-fonts?ref=master" 2>/dev/null |
            awk -v RS=',' -F'"' '/name/ {print $4}')

        if [[ -z "$font_list" ]]; then
            error_msg "Failed to fetch the Nerd Fonts catalog."
            return 1
        fi

        printf '%s\n' "$font_list" > "$ALL_FONTS_FILE"
    }

    get_all_fonts() {
        if [[ ! -f "$ALL_FONTS_FILE" || "$NEW_RELEASE_AVAILABLE" == "true" ]]; then
            create_all_fonts_file || return 1
        fi

        ALL_FONTS=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && ALL_FONTS+=("$line")
        done < "$ALL_FONTS_FILE"
    }

    get_installed_fonts() {
        local -a installed_user_fonts=()
        local font
        local file

        shopt -s nullglob
        installed_user_fonts=("$FONTS_DIR"/*)
        shopt -u nullglob

        INSTALLED_FONTS=()
        for file in "${installed_user_fonts[@]}"; do
            installed_user_fonts+=("${file##*/}")
        done

        local -a basenames=()
        for file in "${installed_user_fonts[@]}"; do
            basenames+=("${file##*/}")
        done

        for font in "${ALL_FONTS[@]}"; do
            if printf '%s\n' "${basenames[@]}" 2>/dev/null | grep -Fxq "$font"; then
                INSTALLED_FONTS+=("$font")
            fi
        done
    }

    filter_installed_fonts() {
        FONT_OPTIONS=()
        if [[ "$INCLUDE_INSTALLED_FONTS" == "false" ]]; then
            for font in "${ALL_FONTS[@]}"; do
                if ! printf '%s\n' "${INSTALLED_FONTS[@]}" 2>/dev/null | grep -Fxq "$font" || ! is_latest_version "$font"; then
                    FONT_OPTIONS+=("$font")
                fi
            done
        else
            FONT_OPTIONS=("${ALL_FONTS[@]}")
        fi
    }

    download_font() {
        local font_name="$1"
        local archive_path="$CACHE_DIR/${font_name}.tar.xz"
        local url="${NERDFONTSREPO}/releases/download/${RELEASE}/${font_name}.tar.xz"

        echo -n "Downloading $font_name... "
        curl --fail --location --silent --show-error --output "$archive_path" "$url" || {
            echo "failed"
            return 1
        }
        echo "done"
    }

    extract_font() {
        local font_name="$1"
        local archive_path="$CACHE_DIR/${font_name}.tar.xz"
        local install_dir="$FONTS_DIR/$font_name"

        echo -n "Installing $font_name... "
        mkdir -p -- "$install_dir"
        tar -xf "$archive_path" -C "$FONTS_DIR" || {
            echo "failed"
            return 1
        }

        rm -rf -- "$install_dir"
        rm -f -- "$FONTS_DIR/LICENSE"
        rm -f -- "$FONTS_DIR/LICENSE.txt"
        rm -f -- "$FONTS_DIR/OFL.txt"
        rm -f -- "$FONTS_DIR/README.md"

        echo "done"
    }

    save_font_release() {
        local font_name="$1"
        printf '%s\n' "$RELEASE" > "$(get_font_release_file "$font_name")"
    }

    remove_font_archives() {
        echo -n "Removing downloaded font archives... "
        for font in "${SELECTED_FONTS[@]}"; do
            rm -f -- "$CACHE_DIR/$font.tar.xz"
        done
        echo "done"
    }

    install_font() {
        local font_name="$1"
        rm -f -- "$CACHE_DIR/$font_name.tar.xz"
        download_font "$font_name" && extract_font "$font_name" && save_font_release "$font_name"
    }

    direct_install() {
        local input="$1"
        local font_name
        local -a names=()

        read -r -a names <<< "$(tr ',' ' ' <<< "$input")"

        for font_name in "${names[@]}"; do
            if printf '%s\n' "${ALL_FONTS[@]}" | grep -Fxq "$font_name"; then
                SELECTED_FONTS+=("$font_name")
            else
                error_msg "Invalid font name: $font_name. Try again."
            fi
        done
    }

    display_installed_fonts() {
        if (( ${#INSTALLED_FONTS[@]} == 0 )); then
            return 1
        fi

        title "Installed Nerd Fonts:"
        for font in "${INSTALLED_FONTS[@]}"; do
            local font_release_file
            font_release_file="$(get_font_release_file "$font")"
            if [[ -f "$font_release_file" ]]; then
                local version
                version=$(cat "$font_release_file" 2>/dev/null || true)
                printf '%s - %s\n' "$font" "$version"
            else
                printf '%s - unknown version\n' "$font"
            fi
        done
    }

    display_all_fonts() {
        title "Nerd Fonts ${RELEASE}:"
        cat "$ALL_FONTS_FILE"
    }

    display_font_menu() {
        local term_width
        term_width=$(stty size 2>/dev/null | cut -d ' ' -f 2 || echo 80)
        title "Nerd Fonts ${RELEASE}:"
        {
            for i in "${!FONT_OPTIONS[@]}"; do
                printf '%d) %s\n' "$((i + 1))" "${FONT_OPTIONS[$i]}"
            done
            printf 'q) Quit\n'
        } | pr -3 -t -w "$term_width"
    }

    parse_range() {
        if ! [[ $1 =~ ^[0-9]+-[0-9]+$ ]]; then
            alert "Invalid input format: $1. Expected format: X-Y."
            return 1
        fi

        local -a range=()
        IFS='-' read -r -a range <<< "$1"
        local range_start="${range[0]}"
        local range_end="${range[1]}"
        local i

        for ((i = range_start; i <= range_end; i++)); do
            local index=$((i - 1))
            if (( index >= 0 && index < ${#FONT_OPTIONS[@]} )); then
                SELECTED_FONTS+=("${FONT_OPTIONS[$index]}")
            else
                alert "Invalid option: $i. Try again."
                return 1
            fi
        done
    }

    handle_input() {
        while true; do
            local choices
            echo
            read -r -p "Enter font number(s) (e.g. 1,2,3 or 1-3 or 1,3-5): " choices
            echo

            for choice in $(printf '%s' "$choices" | tr ',' ' '); do
                if [[ "$choice" == "q" ]]; then
                    confirm "Goodbye!"
                    echo
                    banner
                    return
                elif [[ "$choice" == *-* ]]; then
                    parse_range "$choice" || continue 2
                elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#FONT_OPTIONS[@]} )); then
                    SELECTED_FONTS+=("${FONT_OPTIONS[$((choice - 1))]}")
                else
                    alert "Invalid option: $choice. Try again."
                    continue 2
                fi
            done

            title "Selected Nerd Fonts: ${SELECTED_FONTS[*]}"
            break
        done
    }

    menu_install() {
        get_installed_fonts
        filter_installed_fonts
        banner
        display_installed_fonts || true
        display_font_menu
        handle_input
    }

    main() {
        check_dependencies || return 1
        RELEASE=$(get_latest_release_version) || return 1
        get_all_fonts || return 1

        if [[ "$DISPLAY_INSTALLED_FONTS" == "true" ]]; then
            get_installed_fonts
            if ! display_installed_fonts; then
                info "No installed Nerd Fonts found."
            fi
            return 0
        fi

        if [[ "$DISPLAY_ALL_FONTS" == "true" ]]; then
            display_all_fonts
            return 0
        fi

        SELECTED_FONTS=()
        if [[ "$UPDATE_INSTALLED_FONTS" == "true" ]]; then
            get_installed_fonts
            if (( ${#INSTALLED_FONTS[@]} == 0 )); then
                error_msg "No installed Nerd Fonts found."
                return 1
            fi

            for font in "${INSTALLED_FONTS[@]}"; do
                if ! is_latest_version "$font"; then
                    SELECTED_FONTS+=("$font")
                fi
            done

            if (( ${#SELECTED_FONTS[@]} == 0 )); then
                confirm "All installed Nerd Fonts are up to date."
                return 0
            fi

            info "Updating installed Nerd Fonts: ${SELECTED_FONTS[*]}"
        elif [[ -n "${FONTNAMES:-}" ]]; then
            direct_install "$FONTNAMES"
        else
            menu_install
        fi

        if (( ${#SELECTED_FONTS[@]} > 0 )); then
            for font in "${SELECTED_FONTS[@]}"; do
                install_font "$font" || return 1
            done

            if [[ "$KEEP_FONT_ARCHIVES" == "false" ]]; then
                remove_font_archives
            else
                info "The downloaded font archives can be found in $CACHE_DIR"
            fi
        else
            error_msg "No fonts were selected, back to menu."
        fi
    }

    main "$@"
}

# -----------------------------------------------------------------------------
# Import local or remote theme file
# -----------------------------------------------------------------------------
import_files() {
    local temp_file
    temp_file=$(mktemp "$TERMUX_DIR/tmp/termux_XXXXXXXXXX.properties" 2>/dev/null || mktemp "/tmp/termux_XXXXXXXXXX.properties")

    echo "    ${BLUE}[${RED}L${BLUE}] ${ORANGE}Local File (Enter path to file)"
    echo "    ${BLUE}[${RED}I${BLUE}] ${ORANGE}Internet File (Enter File URL)"
    echo
    read -r -p "    ${BLUE}[${RED}Select Option${BLUE}]: ${GREEN}" option
    echo

    if [[ "$option" =~ ^[lL]$ ]]; then
        local file_path
        local basename

        read -r -p "    ${BLUE}[${RED}Enter/Paste Path To Color-scheme${BLUE}]: ${GREEN}" file_path
        echo

        if [[ ! -f "$file_path" ]]; then
            echo "    ${BLUE}[${RED}!${BLUE}] ${RED}File not found: $file_path"
            return 1
        fi

        basename="${file_path##*/}"
        cp -- "$file_path" "$COLORS_DIR/$basename"
        ln -sfn -- "$COLORS_DIR/$basename" "$TERMUX_DIR/colors.properties"
        reload_settings
        reset_color
        return 0
    fi

    if [[ "$option" =~ ^[iI]$ ]]; then
        local file_link
        local basename

        read -r -p "    ${BLUE}[${RED}Enter Color-scheme URL${BLUE}]: ${GREEN}" file_link
        echo

        if ! curl --fail --silent --show-error --output "$temp_file" "$file_link"; then
            echo "    ${BLUE}[${RED}!${BLUE}] ${RED}Failed to download the color-scheme."
            rm -f -- "$temp_file"
            return 1
        fi

        basename="${file_link##*/}"
        if [[ -z "$basename" || "$basename" == "http:" || "$basename" == "https:" ]]; then
            basename="imported_theme.properties"
        fi

        cp -- "$temp_file" "$COLORS_DIR/$basename"
        ln -sfn -- "$COLORS_DIR/$basename" "$TERMUX_DIR/colors.properties"
        reload_settings
        reset_color
        rm -f -- "$temp_file"
        return 0
    fi

    echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Back to menu."
    echo
    reset_color
    return 1
}

# -----------------------------------------------------------------------------
# Main menu
# -----------------------------------------------------------------------------
ensure_dirs

total_colors=$(check_files colors)
total_dircolors=$(check_files dircolor)
total_fonts=$(check_files fonts)

until [[ "${REPLY:-}" =~ ^[qQ]$ ]]; do
    active_color=""
    active_dircolor=""
    active_font=""

    if [[ -L "$TERMUX_DIR/colors.properties" ]]; then
        active_color=$(readlink "$TERMUX_DIR/colors.properties" 2>/dev/null || true)
        active_color="${active_color##*/}"
        active_color="${active_color%.*}"
    fi

    if [[ -L "$HOME/.dircolors" ]]; then
        active_dircolor=$(readlink "$HOME/.dircolors" 2>/dev/null || true)
        active_dircolor="${active_dircolor##*/}"
        active_dircolor="${active_dircolor%.*}"
    fi

    if [[ -L "$TERMUX_DIR/font.ttf" ]]; then
        active_font=$(readlink "$TERMUX_DIR/font.ttf" 2>/dev/null || true)
        active_font="${active_font##*/}"
        active_font="${active_font%.*}"
    fi

    [[ -n "$active_color" ]] || active_color="none"
    [[ -n "$active_dircolor" ]] || active_dircolor="none"
    [[ -n "$active_font" ]] || active_font="none"

    banner
    echo "
    ${BLUE}[${RED}C${BLUE}] ${GREEN}Colors ($total_colors) (${CYAN}${active_color}${GREEN})
    ${BLUE}[${RED}L${BLUE}] ${GREEN}Dircolors ($total_dircolors) (${CYAN}${active_dircolor}${GREEN})
    ${BLUE}[${RED}F${BLUE}] ${GREEN}Fonts ($total_fonts) (${CYAN}${active_font}${GREEN})
    ${BLUE}[${RED}R${BLUE}] ${GREEN}Random
    ${BLUE}[${RED}D${BLUE}] ${GREEN}Download
    ${BLUE}[${RED}I${BLUE}] ${GREEN}Import
    ${BLUE}[${RED}Q${BLUE}] ${GREEN}Quit
    "

    read -r -p "    ${BLUE}[${RED}Select Option${BLUE}]: ${GREEN}" REPLY
    echo

    case "${REPLY^^}" in
        C)
            apply_colors
            ;;
        L)
            apply_dircolor
            ;;
        F)
            apply_fonts
            ;;
        R)
            random_style
            ;;
        D)
            download_fonts
            ;;
        I)
            import_files
            ;;
        Q)
            ;;
        *)
            echo -n "    ${BLUE}[${RED}!${BLUE}] ${RED}Invalid Option, Try Again."
            echo
            ;;
    esac

    total_colors=$(check_files colors)
    total_dircolors=$(check_files dircolor)
    total_fonts=$(check_files fonts)
done

echo "    ${BLUE}[${RED}*${BLUE}] ${RED}Bye Bye, Have A Nice Day!"
echo
reset_color
clear
exit 0
